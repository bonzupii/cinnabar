{
  "comments": {
    "lineComment": "#",
    "blockComment": [
      "#|",
      "|#"
    ]
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "#|",
      "close": "|#"
    },
    {
      "open": "#!|",
      "close": "|#"
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ],
    [
      "#|",
      "|#"
    ],
    [
      "#!|",
      "|#"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:pub\\s+)?(?:nat\\s+)?(?:mod|trait|impl)\\b.*$|^\\s*(?:pub\\s+)?(?:impure\\s+)?(?!nat\\b)(?:fun|type)\\b.*$|^\\s*(?:if|elif|else|while|match)\\b.*$|.*(?:=\\s*match\\b|(?:^|\\s)return\\s+match\\b).*$",
    "decreaseIndentPattern": "^\\s*(?:end|elif|else)\\b.*$|\\|#\\s*$"
  },
  "onEnterRules": [
    {
      "beforeText": "^\\s*#!?\\|\\s*$",
      "afterText": "^\\s*\\|#\\s*$",
      "action": {
        "indentAction": "IndentOutdent"
      }
    },
    {
      "beforeText": "^\\s*#!?\\|.*$",
      "action": {
        "indentAction": "Indent"
      }
    }
  ]
}
