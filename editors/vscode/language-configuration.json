{
  "comments": {
    "lineComment": "#",
    "blockComment": [
      "#|",
      "|#"
    ]
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "{",
      "close": "}"
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "{",
      "}"
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:pub\\s+)?(?:impure\\s+)?(?:nat\\s+)?(?:fun|mod|type|trait|impl)\\b|(?:if|elif|else|while|match)\\b).*$",
    "decreaseIndentPattern": "^\\s*(?:end|elif|else)\\b.*$"
  }
}
