pub const DEFAULT_PORT: Int = 8080 # trailing ordinary comments are legal

pub type Unit
  pub Unit
end

pub type Option(T)
  pub Some(T)
  pub None
end

pub type Port
  pub Port(Int)
end

pub fun unit_demo() Unit
  return Unit
end

pub fun port_demo() Port
  return Port(DEFAULT_PORT)
end

pub fun option_demo() Option(Int)
  val some_value = Some(1)
  val none_value = None
  return none_value
end
pub fun main() Unit
  val p = port_demo()
  val o = option_demo()
  return Unit
end
