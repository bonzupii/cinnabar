pub const DEFAULT_PORT: I64 = 8080 # trailing ordinary comments are legal

pub type Port
  pub Port(I64)
end

pub fun unit_demo() Unit
  return Unit
end

pub fun port_demo() Port
  return Port(DEFAULT_PORT)
end

pub fun option_demo() Option(I64)
  val some_value = Some(1)
  val none_value = None
  return none_value
end
pub fun main() Unit
  val p = port_demo()
  val o = option_demo()
  return Unit
end
