const DEFAULT_PORT: I64 = 8080 # trailing ordinary comments are legal

type Port
  Port(I64)
end

fun unit_demo() Unit
  return Unit
end

fun port_demo() Port
  return Port(DEFAULT_PORT)
end

fun option_demo() Option(I64)
  val some_value = Some(1)
  val none_value = None
  return none_value
end
fun main() Unit
  val u = unit_demo()
  val p = port_demo()
  val o = option_demo()
  return Unit
end
