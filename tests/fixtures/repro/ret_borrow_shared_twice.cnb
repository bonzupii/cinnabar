# ret_borrow_shared_twice (bug-report d5 control): a native slice view of
# the same input taken twice as shared borrows is legal (multiple shared
# borrows coexist); only exclusive borrows and moves conflict.  The binary
# must compile and exit 0.

pub mod Collections
  pub nat type Vec(T)
  pub type Error
    pub AllocationFailed(Usize)
    pub IndexOutOfBounds(Usize)
  end
  pub nat fun vec_new<T>() impure Result(Vec(T), Error)
  pub nat fun vec_view<T>(vec: &Vec(T)) &[T]
  pub nat fun vec_free<T>(vec: Vec(T)) impure Unit
end

use Collections.vec_new
use Collections.vec_view
use Collections.vec_free

pub fun main() Int
  val x = match vec_new[Int]()
    Ok(v) => v
    Err(error) => return 1
  end

  val r = vec_view(&x)
  val r2 = vec_view(&x)

  val used = match r
    [] => 0
    [first, rest @ ..] => first
  end

  vec_free(x)
  return used
end
