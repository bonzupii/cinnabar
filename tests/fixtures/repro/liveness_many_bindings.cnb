#!|
  Liveness-fixpoint regression.

  This function declares 40 local bindings and creates zero borrow paths.
  The liveness analysis's convergence cap must be derived from the
  binding count, not the path count: with zero paths a path-derived cap
  degenerates to 1 and rejects any program whose analysis needs two
  sweeps, e.g. any loop whose body reads local bindings.  Every binding
  is read inside the loop body, so live sets grow across sweeps and the
  analysis must converge within the binding-derived bound.
|#
pub fun main() Int
  var a0: Int = 0
  var a1: Int = 1
  var a2: Int = 2
  var a3: Int = 3
  var a4: Int = 4
  var a5: Int = 5
  var a6: Int = 6
  var a7: Int = 7
  var a8: Int = 8
  var a9: Int = 9
  var b0: Int = 0
  var b1: Int = 1
  var b2: Int = 2
  var b3: Int = 3
  var b4: Int = 4
  var b5: Int = 5
  var b6: Int = 6
  var b7: Int = 7
  var b8: Int = 8
  var b9: Int = 9
  var c0: Int = 0
  var c1: Int = 1
  var c2: Int = 2
  var c3: Int = 3
  var c4: Int = 4
  var c5: Int = 5
  var c6: Int = 6
  var c7: Int = 7
  var c8: Int = 8
  var c9: Int = 9
  var d0: Int = 0
  var d1: Int = 1
  var d2: Int = 2
  var d3: Int = 3
  var d4: Int = 4
  var d5: Int = 5
  var d6: Int = 6
  var d7: Int = 7
  var d8: Int = 8
  var d9: Int = 9
  var i: Int = 0

  while i < 100
    a0 = a0 + b0
    a1 = a1 + b1
    a2 = a2 + b2
    a3 = a3 + b3
    a4 = a4 + b4
    a5 = a5 + b5
    a6 = a6 + b6
    a7 = a7 + b7
    a8 = a8 + b8
    a9 = a9 + b9
    b0 = b0 + c0
    b1 = b1 + c1
    b2 = b2 + c2
    b3 = b3 + c3
    b4 = b4 + c4
    b5 = b5 + c5
    b6 = b6 + c6
    b7 = b7 + c7
    b8 = b8 + c8
    b9 = b9 + c9
    c0 = c0 + d0
    c1 = c1 + d1
    c2 = c2 + d2
    c3 = c3 + d3
    c4 = c4 + d4
    c5 = c5 + d5
    c6 = c6 + d6
    c7 = c7 + d7
    c8 = c8 + d8
    c9 = c9 + d9
    d0 = d0 + a0
    d1 = d1 + a1
    d2 = d2 + a2
    d3 = d3 + a3
    d4 = d4 + a4
    d5 = d5 + a5
    d6 = d6 + a6
    d7 = d7 + a7
    d8 = d8 + a8
    d9 = d9 + a9
    i = i + 1
  end

  return i
end
