# The O(1) call-stack guarantee rejects non-tail self-recursion
# (`Usize.from(first) + slice_sum(rest)` recurses as an operand of `+`),
# so the sum is a tail-recursive accumulator folding each first byte
# into the accumulator before recursing on the rest.
fun slice_sum_acc(view: &[U8], acc: Usize) Usize
  match view
    [] => return acc
    [first, rest @ ..] => return slice_sum_acc(rest, acc + Usize.from(first))
  end
end

fun slice_sum(view: &[U8]) Usize
  return slice_sum_acc(view, 0)
end

const MAGIC_BYTE_0: U8 = 0x0D
const MAGIC_BYTE_1: U8 = 0xF0
const MAGIC_BYTE_2: U8 = 0xAD
const MAGIC_BYTE_3: U8 = 0x0B

# 0x0D + 0xF0 + 0xAD + 0x0B = 13 + 240 + 173 + 11 = 437
const EXPECTED_SUM: Usize = 437

fun array_as_slice() Usize
  val bytes: [U8; 4] = [MAGIC_BYTE_0, MAGIC_BYTE_1, MAGIC_BYTE_2, MAGIC_BYTE_3]
  return slice_sum(&bytes)
end

fun main() I64
  if array_as_slice() == EXPECTED_SUM
    return 0
  end

  return 1
end
