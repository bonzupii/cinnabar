#! Bug-report 2a fixed-shape lock: a struct containing a linear value IS
#! consumable end-to-end -- move the field out into a binding, consume the
#! binding, and exit with the parent partially moved but every linear
#! sub-node consumed.

pub mod Collections
  pub nat type Vec(T)
  pub type Error
    pub AllocationFailed(Usize)
    pub IndexOutOfBounds(Usize)
  end
  pub nat fun vec_new<T>() impure Result(Vec(T), Error)
  pub nat fun vec_free<T>(vec: Vec(T)) impure Unit
end

type Holder
  vec: Collections.Vec(I64)
end

use Collections.vec_new
use Collections.vec_free

fun make_holder() impure Result(Holder, Collections.Error)
  val v = match vec_new[I64]()
    Ok(value) => value
    Err(error) => return Err(error)
  end
  return Ok(Holder(vec: v))
end

fun main() impure I64
  val h = match make_holder()
    Ok(value) => value
    Err(error) => return 1
  end

  val v = h.vec
  vec_free(v)
  return 0
end
