#! Drain-before-free (MANIFESTO): freeing a native container that may
#! hold linear elements is a compile error.  The Vec gains a linear Block
#! via vec_push but is freed without draining, so vec_free must be
#! rejected with "cannot free container holding linear elements: drain
#! the container (pop all elements) before freeing".  vec_pop is declared
#! so the insertion itself is legal under the Resolvability Rule.  The
#! error paths consume the Vec through fail_vec_free (which drains before
#! freeing), so the only diagnostic is the drain error.

pub mod Collections
  pub nat type Vec(T)

  pub type Error
    pub AllocationFailed(Usize)
    pub IndexOutOfBounds(Usize, Usize)
  end

  pub nat fun vec_new<T>() impure Result(Vec(T), Error)
  pub nat fun vec_push<T>(vec: &mut Vec(T), value: T) impure Result(Unit, Error)
  pub nat fun vec_pop<T>(vec: &mut Vec(T)) impure Result(T, Error)
  pub nat fun vec_free<T>(vec: Vec(T)) impure Unit
end

pub mod Memory
  pub nat type Block
  pub type Error
    pub AllocationFailed(Usize)
  end
  pub nat fun allocate(size: Usize) impure Result(Block, Error)
  pub nat fun deallocate(block: Block) impure Unit
end

use Collections.vec_new
use Collections.vec_push
use Collections.vec_pop
use Collections.vec_free
use Collections.Vec
use Memory.allocate
use Memory.deallocate

fun fail_vec_free(vec: Collections.Vec(Memory.Block)) impure I64
  while true
    match vec_pop(&mut vec)
      Ok(elem) => deallocate(elem)
      Err(error) => break
    end
  end
  vec_free(vec)
  return 1
end

pub fun main() impure I64
  val vec = match vec_new[Memory.Block]()
    Ok(v) => v
    Err(error) => return 1
  end

  val block = match allocate(64)
    Ok(b) => b
    Err(error) => return fail_vec_free(vec)
  end

  match vec_push(&mut vec, block)
    Ok(v) => v
    Err(error) => return fail_vec_free(vec)
  end

  vec_free(vec)
  return 0
end
