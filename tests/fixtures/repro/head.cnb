#!|
  Cinnabar version one reference implementation.

  This program exercises structs, trait-based polymorphism, bitwise math,
  compiler-enforced casing, and mutable local state under loop control.
  Every declaration below is reachable from main -- dead code is a
  compiler error here, the same as anywhere else, so a language-tour
  fixture cannot declare more surface than it actually exercises.

  Casing:
  - functions, val names, and var names: snake_case
  - types, traits, modules, enum variants: PascalCase
  - constants: SCREAMING_SNAKE_CASE

  Bindings:
  - const: compile-time constant
  - val: immutable local binding
  - var: mutable local binding

  Generics:
  - trait-based polymorphism: pub trait Checksum ... pub impl Checksum for T

  Control flow:
  - while supports break and continue
  - trailing comments may appear after any line of code

  Visibility:
  - declarations are private by default
  - pub exposes a declaration
  - pub on local val/var is a compiler error
  - compiler diagnostics are errors only; no warning severity
|#

# This is an ordinary comment.
#! This is a documentation comment.
#|
  This is a block comment.
|#
#!|
  This is a block documentation comment.
|#

pub const ZERO_INT: I64 = 0

pub const LOOP_LIMIT: I64 = 5

pub const CHECKSUM_SALT: U32 = 0x0F

pub type Header
  pub kind: U32
  pub flags: U32
end

pub type Tag
  pub value: U32
end

# Trait-based polymorphism.
pub trait Checksum
  pub fun checksum(value: &Self) U32
end

pub impl Checksum for Header
  pub fun checksum(value: &Header) U32
    return ((value.kind << 16) ^ (value.flags << 8) ^ value.kind ^ value.flags)
  end
end

pub impl Checksum for Tag
  pub fun checksum(value: &Tag) U32
    return value.value ^ CHECKSUM_SALT
  end
end

#! Demonstrates var for mutable local state.
#! Compiler error if total or i is val: assignment requires var.
fun sum_to(limit: I64) I64
  var total: I64 = ZERO_INT
  var i: I64 = ZERO_INT

  while i < limit
    total = total + i
    i = i + 1
  end

  return total
end

pub fun main() I64
  return sum_to(LOOP_LIMIT)
end
