#!|
  Cinnabar version one reference implementation.

  This program exercises modules, traits, generics, fixed-size arrays,
  slices, rest patterns, growable collections, bitwise math, opaque native
  memory handles, explicit Result handling, explicit Option handling,
  structs, visibility, imports, loop control, and compiler-enforced casing.

  Casing:
  - functions, val names, and var names: snake_case
  - types, traits, modules, enum variants: PascalCase
  - constants: SCREAMING_SNAKE_CASE

  Bindings:
  - const: compile-time constant
  - val: immutable local binding
  - var: mutable local binding

  Borrowing:
  - &T is a shared borrow
  - &mut T is an exclusive mutable borrow
  - borrow scopes are flow-sensitive and cannot outlive the owner
  - no lifetime annotations exist
  - ambiguous returned borrows are compiler errors
  - linear handles must be consumed exactly once

  Generics:
  - type constructors use parentheses: Vec(T)
  - function type parameters use angle brackets: fun f<T>
  - explicit call-site instantiation uses square brackets: f[U8]()
  - return-type-only type parameters are inferred from call context

  Control flow:
  - while supports break and continue
  - try works for Result and Option
  - use imports are explicit and may alias with as
  - slice and array rest patterns must bind remaining elements
  - trailing comments may appear after any line of code

  Visibility:
  - declarations are private by default
  - pub exposes a declaration
  - pub on local val/var is a compiler error
  - pub inside a private mod is legal but not externally reachable until the mod is pub
  - compiler diagnostics are errors only; no warning severity
|#

# This is an ordinary comment.
#! This is a documentation comment.
#|
  This is a block comment.
|#
#!|
  This is a block documentation comment.
|#

pub const ZERO_INT: I64 = 0
pub const LOOP_LIMIT: I64 = 5
pub const CHECKSUM_SALT: U32 = 0x0F

pub type Header
  pub kind: U32
  pub flags: U32
end

pub type Tag
  pub value: U32
end

#! Groups binary magic data that is always passed together.
pub type MagicHeader
  pub bytes: [U8; 4]
  pub expected: U32
end

#! Runtime is a public mod.
pub mod Runtime
  pub type Error
    pub NotReady
    pub ProbeFailed(I64)
  end

  pub nat fun self_check() impure Result(Unit, Error)

  #! Compiler error if a local inside probe_twice were marked pub:
  #!   pub val probe_count: I64 = 2
  #! pub cannot appear on local val/var.
  fun probe_twice() impure Result(Unit, Error)
    try self_check()
    try self_check()
    return Ok(Unit)
  end

  #! Compiler errors:
  #! - unhandled Result from Runtime.gate: propagate with try or match both variants
  #! - missing Runtime.Error branch: match must be exhaustive
  pub fun gate() impure Result(Unit, Error)
    try probe_twice()
    return Ok(Unit)
  end
end

#! Memory is a public mod.
#|
  Raw memory quarantine.

  Cinnabar code sees opaque Block handles.
  It never sees pointers.
|#
pub mod Memory
  #! Block is a linear handle.
  #! Compiler errors:
  #! - dropping Block without deallocate: linear value Memory.Block must be consumed
  #! - using Block after deallocate: value used after move
  #! - duplicating Block: linear value cannot be copied
  pub nat type Block

  pub type Error
    pub AllocationFailed(Usize)
    pub AccessOutOfBounds(Usize, Usize)
  end

  pub nat fun allocate(size: Usize) impure Result(Block, Error)

  pub nat fun deallocate(block: Block) impure Unit

  pub nat fun write_u8(
    block: &Block,
    offset: Usize,
    value: U8
  ) impure Result(Unit, Error)

  pub nat fun read_u8(
    block: &Block,
    offset: Usize
  ) impure Result(U8, Error)
end

#! Binary is a public mod.
#|
  Binary parsing helpers.
|#
pub mod Binary
  pub type Error
    pub MagicMismatch(U32)
  end

  # Private helper.
  fun combine_le_bytes(b0: U8, b1: U8, b2: U8, b3: U8) U32
    val v0 = U32.from(b0)
    val v1 = U32.from(b1)
    val v2 = U32.from(b2)
    val v3 = U32.from(b3)

    return (v3 << 24) | (v2 << 16) | (v1 << 8) | v0
  end

  # Private helper.
  fun u32_from_le_bytes(bytes: [U8; 4]) U32
    match bytes
      [b0, b1, b2, b3] => return combine_le_bytes(b0, b1, b2, b3)
    end
  end

  #! Compiler errors:
  #! - unhandled Result: propagate with try or match MagicMismatch explicitly
  pub fun check_magic(header: &MagicHeader) Result(Unit, Error)
    val value = u32_from_le_bytes(header.bytes)

    if value == header.expected
      return Ok(Unit)
    end

    return Err(MagicMismatch(value))
  end
end

#! Slice is a public mod.
pub mod Slice
  pub nat fun len<T>(view: &[T]) Usize
end

#! Collections is a public mod.
#! These are the standard growable collection surfaces required for self-hosting.
pub mod Collections
  pub nat type Vec(T)

  #! String is UTF-8 validated.
  #! string_from_slice returns InvalidUtf8 for malformed input.
  pub nat type String

  pub nat type HashMap(K, V)

  pub type Error
    pub AllocationFailed(Usize)
    pub IndexOutOfBounds(Usize)
    pub KeyNotFound
    pub EmptySlice
    pub InvalidUtf8
  end

  pub nat fun vec_new<T>() impure Result(Vec(T), Error)

  pub nat fun vec_push<T>(
    vec: &mut Vec(T),
    value: T
  ) impure Result(Unit, Error)

  pub nat fun vec_view<T>(vec: &Vec(T)) &[T]

  pub nat fun vec_free<T>(vec: Vec(T)) impure Unit

  pub nat fun string_from_slice(view: &[U8]) impure Result(String, Error)

  pub nat fun string_len(value: &String) Usize

  pub nat fun string_free(value: String) impure Unit

  pub nat fun hash_map_new<K, V>() impure Result(HashMap(K, V), Error)

  pub nat fun hash_map_insert<K, V>(
    map: &mut HashMap(K, V),
    key: K,
    value: V
  ) impure Result(Unit, Error)

  pub nat fun hash_map_get<K, V>(
    map: &HashMap(K, V),
    key: K
  ) impure Result(V, Error)

  pub nat fun hash_map_free<K, V>(map: HashMap(K, V)) impure Unit
end

#! Explicit imports.
#! Unknown or unused imports are compiler errors.
use Runtime.gate
use Memory.allocate
use Memory.deallocate
use Memory.write_u8
use Memory.read_u8
use Binary.check_magic as verify_magic
use Slice.len as slice_len
use Collections.vec_new
use Collections.vec_push
use Collections.vec_view
use Collections.vec_free
use Collections.string_from_slice
use Collections.string_len
use Collections.string_free
use Collections.hash_map_new
use Collections.hash_map_insert
use Collections.hash_map_get
use Collections.hash_map_free

# Trait-based polymorphism.
pub trait Checksum
  pub fun checksum(value: &Self) U32
end

pub impl Checksum for Header
  pub fun checksum(value: &Header) U32
    return ((value.kind << 16) ^ (value.flags << 8) ^ value.kind ^ value.flags)
  end
end

pub impl Checksum for Tag
  pub fun checksum(value: &Tag) U32
    return value.value ^ CHECKSUM_SALT
  end
end

#! Demonstrates var for mutable local state.
#! Compiler error if total or i is val: assignment requires var.
fun sum_to(limit: I64) I64
  var total: I64 = ZERO_INT
  var i: I64 = ZERO_INT

  while i < limit
    total = total + i
    i = i + 1
  end

  return total
end

pub fun main() I64
  return sum_to(LOOP_LIMIT)
end
