#! Every native surface exercised end to end, in one program.
#!
#! A smoke test for the full runtime: `Runtime.self_check` (through its
#! `gate` helper), `Memory` allocate/write/read/deallocate, `String`
#! build/measure/free, `HashMap` insert/get/free, and `Vec` push/view/
#! measure/free.  Each surface consumes its linear handles exactly once on
#! every path, and every failure carries a distinct exit code so a single
#! broken surface cannot masquerade as another.
#!
#! Exit code 0 means every check passed; a non-zero code names the failing
#! check (see `main`).

pub mod Runtime
  pub type Error
    pub NotReady
    pub ProbeFailed(I64)
  end

  pub nat fun self_check() impure Result(Unit, Error)

  fun probe_twice() impure Result(Unit, Error)
    try self_check()
    try self_check()
    return Ok(Unit)
  end

  pub fun gate() impure Result(Unit, Error)
    try probe_twice()
    return Ok(Unit)
  end
end

pub mod Memory
  pub nat type Block
  pub type Error
    pub AllocationFailed(Usize)
    pub AccessOutOfBounds(Usize, Usize)
  end
  pub nat fun allocate(size: Usize) impure Result(Block, Error)
  pub nat fun deallocate(block: Block) impure Unit
  pub nat fun write_u8(block: &Block, offset: Usize, value: U8) impure Result(Unit, Error)
  pub nat fun read_u8(block: &Block, offset: Usize) impure Result(U8, Error)
end

pub mod Slice
  pub nat fun len<T>(view: &[T]) Usize
end

pub mod Collections
  pub nat type Vec(T)
  pub nat type String
  pub nat type HashMap(K, V)

  pub type Error
    pub AllocationFailed(Usize)
    pub IndexOutOfBounds(Usize)
    pub KeyNotFound
    pub EmptySlice
    pub InvalidUtf8
  end

  pub nat fun vec_new<T>() impure Result(Vec(T), Error)
  pub nat fun vec_push<T>(vec: &mut Vec(T), value: T) impure Result(Unit, Error)
  pub nat fun vec_view<T>(vec: &Vec(T)) &[T]
  pub nat fun vec_free<T>(vec: Vec(T)) impure Unit
  pub nat fun string_from_slice(view: &[U8]) impure Result(String, Error)
  pub nat fun string_len(value: &String) Usize
  pub nat fun string_free(value: String) impure Unit
  pub nat fun hash_map_new<K, V>() impure Result(HashMap(K, V), Error)
  pub nat fun hash_map_insert<K, V>(map: &mut HashMap(K, V), key: K, value: V) impure Result(Unit, Error)
  pub nat fun hash_map_get<K, V>(map: &HashMap(K, V), key: K) impure Result(V, Error)
  pub nat fun hash_map_free<K, V>(map: HashMap(K, V)) impure Unit
end

use Runtime.gate
use Memory.allocate
use Memory.deallocate
use Memory.write_u8
use Memory.read_u8
use Slice.len as slice_len
use Collections.vec_new
use Collections.vec_push
use Collections.vec_view
use Collections.vec_free
use Collections.string_from_slice
use Collections.string_len
use Collections.string_free
use Collections.hash_map_new
use Collections.hash_map_insert
use Collections.hash_map_get
use Collections.hash_map_free

const BYTE_A: U8 = 0x41
const KEY: I64 = 10
const VALUE: I64 = 100
const WORD: &[U8] = "hello"

fun fail_block(block: Memory.Block, code: I64) impure I64
  deallocate(block)
  return code
end

fun fail_string(text: Collections.String, code: I64) impure I64
  string_free(text)
  return code
end

fun fail_map(map: Collections.HashMap(I64, I64), code: I64) impure I64
  hash_map_free(map)
  return code
end

fun fail_vec(vec: Collections.Vec(I64), code: I64) impure I64
  vec_free(vec)
  return code
end

fun fill_squares(vec: &mut Collections.Vec(I64)) impure Result(Unit, Collections.Error)
  var i: I64 = 0
  while i < 5
    try vec_push(vec, i * i)
    i = i + 1
  end
  return Ok(Unit)
end

pub fun main() impure I64
  match gate()
    Ok(Unit) => Unit
    Err(error) => return 1
  end

  val block = match allocate(1)
    Ok(value) => value
    Err(error) => return 2
  end
  match write_u8(&block, 0, BYTE_A)
    Ok(Unit) => Unit
    Err(error) => return fail_block(block, 3)
  end
  val byte = match read_u8(&block, 0)
    Ok(value) => value
    Err(error) => return fail_block(block, 4)
  end
  deallocate(block)
  if byte != BYTE_A
    return 5
  end

  val text = match string_from_slice(WORD)
    Ok(value) => value
    Err(error) => return 6
  end
  if string_len(&text) != 5
    return fail_string(text, 7)
  end
  string_free(text)

  val map = match hash_map_new[I64, I64]()
    Ok(value) => value
    Err(error) => return 8
  end
  match hash_map_insert(&mut map, KEY, VALUE)
    Ok(Unit) => Unit
    Err(error) => return fail_map(map, 9)
  end
  val got = match hash_map_get(&map, KEY)
    Ok(value) => value
    Err(error) => return fail_map(map, 10)
  end
  if got != VALUE
    return fail_map(map, 11)
  end
  hash_map_free(map)

  val vec = match vec_new[I64]()
    Ok(value) => value
    Err(error) => return 12
  end
  match fill_squares(&mut vec)
    Ok(Unit) => Unit
    Err(error) => return fail_vec(vec, 13)
  end
  val view = vec_view(&vec)
  if slice_len(view) != 5
    return fail_vec(vec, 14)
  end
  vec_free(vec)

  return 0
end
