# [EXPECT REJECTION]
# ret_borrow_uaf (bug-report d7b): the callee may return a view of either
# input, so its returned borrow is ambiguous and the callee is rejected;
# a caller that frees the possibly-aliased earlier input while the returned
# borrow is live is also rejected.  Either diagnostic closes the
# use-after-free; the program must not compile.

pub mod Collections
  pub nat type Vec(T)
  pub type Error
    pub AllocationFailed(Usize)
    pub IndexOutOfBounds(Usize)
  end
  pub nat fun vec_new<T>() impure Result(Vec(T), Error)
  pub nat fun vec_view<T>(vec: &Vec(T)) &[T]
  pub nat fun vec_free<T>(vec: Vec(T)) impure Unit
end

use Collections.vec_new
use Collections.vec_view
use Collections.vec_free

fun choose_ref(a: &Collections.Vec(I64), b: &Collections.Vec(I64)) &[I64]
  if a_len(a) < b_len(b)
    return vec_view(a)
  end
  return vec_view(b)
end

fun a_len(v: &Collections.Vec(I64)) I64
  return 1
end

fun b_len(v: &Collections.Vec(I64)) I64
  return 2
end

fun fail_with_x(x: Collections.Vec(I64)) impure I64
  vec_free(x)
  return 1
end

fun main() impure I64
  val x = match vec_new[I64]()
    Ok(v) => v
    Err(error) => return 1
  end
  val y = match vec_new[I64]()
    Ok(v) => v
    Err(error) => return fail_with_x(x)
  end

  val r = choose_ref(&x, &y)

  vec_free(x)

  val used = match r
    [] => 0
    [first, rest @ ..] => first
  end

  vec_free(y)
  return used
end
