# ret_borrow_single_origin (bug-report d7d): the callee ALWAYS returns a
# view of its first input and provably never borrows the second.  Per the
# ambiguity rule its returned borrow derives from exactly one input
# parameter, so freeing the never-aliased second input while the returned
# borrow is live must compile.
#
# Fix (b) landed: the callee-origin summary records that view_of_a's
# returned borrow traces to parameter 0 only, and the call site seeds the
# returned borrow's origin from that summary instead of conservatively
# unioning every reference argument.  Compiles and exits 0 (empty vec).

pub mod Collections
  pub nat type Vec(T)
  pub type Error
    pub AllocationFailed(Usize)
    pub IndexOutOfBounds(Usize)
  end
  pub nat fun vec_new<T>() impure Result(Vec(T), Error)
  pub nat fun vec_view<T>(vec: &Vec(T)) &[T]
  pub nat fun vec_free<T>(vec: Vec(T)) impure Unit
end

use Collections.vec_new
use Collections.vec_view
use Collections.vec_free

fun view_of_a(a: &Collections.Vec(I64), b: &Collections.Vec(I64)) &[I64]
  return vec_view(a)
end

fun fail_with_x(x: Collections.Vec(I64)) impure I64
  vec_free(x)
  return 1
end

fun main() impure I64
  val x = match vec_new[I64]()
    Ok(v) => v
    Err(error) => return 1
  end
  val y = match vec_new[I64]()
    Ok(v) => v
    Err(error) => return fail_with_x(x)
  end

  val r = view_of_a(&x, &y)

  vec_free(y)

  val used = match r
    [] => 0
    [first, rest @ ..] => first
  end

  vec_free(x)
  return used
end
