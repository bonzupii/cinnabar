# [EXPECT REJECTION]
#! `File.Handle` is linear, so an open descriptor is an obligation the
#! compiler tracks. Every item below must be rejected.
#!
#!   1. A handle that falls out of scope without being closed. A leaked
#!      descriptor is a resource leak the borrow checker can see, so it is
#!      a compile error rather than something to notice in production.
#!   2. A handle closed on one path but not another. Linear consumption is
#!      per-path, not per-function: returning early from the middle of a
#!      file operation is exactly where a leak would otherwise hide.
#!   3. A handle closed twice. The second close would release a descriptor
#!      number the kernel may since have handed back out for something
#!      else, so a later read would silently touch the wrong file.
#!   4. A handle used after it was closed.

pub mod File
  pub nat type Handle

  pub type Mode
    pub ReadOnly
    pub WriteTruncate
    pub WriteAppend
  end

  pub type Error
    pub SystemFault(I64)
  end

  pub nat fun open(path: &[U8], mode: Mode) impure Result(Handle, Error)
  pub nat fun read(file: &Handle, into: &mut [U8]) impure Result(Usize, Error)
  pub nat fun write(file: &Handle, bytes: &[U8]) impure Result(Usize, Error)
  pub nat fun close(file: Handle) impure Unit
end

use File.open
use File.read
use File.write
use File.close

const PATH: &[U8] = "/tmp/cinnabar_unclosed.txt"
const CONTENT: &[U8] = "x"

fun leaked() impure I64
  val handle = match open(PATH, File.ReadOnly)
    Ok(value) => value
    Err(File.SystemFault(code)) => return 1
  end
  return 0
end

fun closed_on_one_path_only(flag: Bool) impure I64
  val handle = match open(PATH, File.ReadOnly)
    Ok(value) => value
    Err(File.SystemFault(code)) => return 1
  end
  if flag
    return 2
  end
  close(handle)
  return 0
end

fun closed_twice() impure I64
  val handle = match open(PATH, File.ReadOnly)
    Ok(value) => value
    Err(File.SystemFault(code)) => return 1
  end
  close(handle)
  close(handle)
  return 0
end

fun used_after_close() impure I64
  val handle = match open(PATH, File.WriteTruncate)
    Ok(value) => value
    Err(File.SystemFault(code)) => return 1
  end
  close(handle)
  match write(&handle, CONTENT)
    Ok(count) => return 0
    Err(File.SystemFault(code)) => return 2
  end
end

fun main() impure I64
  return leaked() + closed_on_one_path_only(true) + closed_twice() + used_after_close()
end
