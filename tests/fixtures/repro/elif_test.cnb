const OP_LOAD: I64 = 0
const OP_HALT: I64 = 7

pub const PROG: I64 = (0x01) | (0x70 << 8)

fun fetch(prog: I64, pc: I64) I64
  return (prog >> (pc * 8)) & 0xFF
end

pub fun main() I64
  var acc: I64 = 0
  var pc: I64 = 0
  var running: Bool = true
  while running
    val code = fetch(PROG, pc)
    val op = code >> 4
    val arg = code & 0xF
    if op == OP_HALT
      running = false
    elif op == OP_LOAD
      acc = arg
      pc = pc + 1
    else
      pc = pc + 1
    end
  end
  return acc
end
