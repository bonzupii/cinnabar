const OP_LOAD: I64 = 0
const OP_MOVC: I64 = 1
const OP_DECC: I64 = 2
const OP_ACCM: I64 = 4
const OP_JMP: I64 = 5
const OP_JZC: I64 = 6
const OP_HALT: I64 = 7

pub const PROG: I64 = (0x01) | (0x15 << 8) | (0x70 << 16)

fun fetch(prog: I64, pc: I64) I64
  return (prog >> (pc * 8)) & 0xFF
end

pub fun main() I64
  var acc: I64 = 0
  var cnt: I64 = 0
  var pc: I64 = 0
  var running: Bool = true

  while running
    val code = fetch(PROG, pc)
    val op = code >> 4
    val arg = code & 0xF

    if op == OP_HALT
      running = false
      continue
    end

    if op == OP_LOAD
      acc = arg
      pc = pc + 1
      continue
    end

    if op == OP_MOVC
      cnt = arg
      pc = pc + 1
      continue
    end

    if op == OP_DECC
      cnt = cnt - 1
      pc = pc + 1
      continue
    end

    if op == OP_ACCM
      acc = acc * cnt
      pc = pc + 1
      continue
    end

    if op == OP_JMP
      pc = arg
      continue
    end

    if op == OP_JZC
      if cnt == 0
        pc = arg
        continue
      end
      pc = pc + 1
      continue
    end

    pc = pc + 1
  end

  return acc
end
