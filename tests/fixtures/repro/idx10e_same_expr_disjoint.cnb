# idx10e_same_expr_disjoint: two `&mut` borrows of DISJOINT elements in
# the SAME call must compile.  The same-expression pending check compares
# element indices exactly like the cross-statement liveness check.
# (EXPECT_OK 30.)
type P
  x: I64
  y: I64
end

fun touch_both(a: &mut P, b: &mut P) I64
  a.x = 10
  b.y = 20
  return a.x + b.y
end

fun main() I64
  var pts: [P; 2] = [P(x: 1, y: 2), P(x: 3, y: 4)]
  return touch_both(&mut pts[0], &mut pts[1])
end
