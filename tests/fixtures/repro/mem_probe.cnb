pub mod Memory
  pub native type Block
  pub type Error
    pub AllocationFailed(Usize)
    pub AccessOutOfBounds(Usize, Usize)
  end
  pub native fun allocate(size: Usize) impure Result(Block, Error)
  pub native fun deallocate(block: Block) impure Unit
  pub native fun write_u8(block: &Block, offset: Usize, value: U8) impure Result(Unit, Error)
  pub native fun read_u8(block: &Block, offset: Usize) impure Result(U8, Error)
end

pub mod Collections
  pub native type Vec(T)
  pub type Error
    pub AllocationFailed(Usize)
    pub IndexOutOfBounds(Usize)
  end
  pub native fun vec_new<T>() impure Result(Vec(T), Error)
  pub native fun vec_push<T>(vec: &mut Vec(T), value: T) impure Result(Unit, Error)
  pub native fun vec_view<T>(vec: &Vec(T)) &[T]
  pub native fun vec_free<T>(vec: Vec(T)) impure Unit
end

use Memory.allocate
use Memory.deallocate
use Memory.write_u8
use Memory.read_u8
use Collections.vec_new
use Collections.vec_push
use Collections.vec_view
use Collections.vec_free

pub mod Slice
  pub native fun len<T>(view: &[T]) Usize
end

use Slice.len as slice_len

const PROBE_RECURSE_DEPTH: Int = 100000

pub const PROBE_BYTE: U8 = 0x42
pub const PROBE_FAIL_BYTE: U8 = 0xFF

fun recurse(n: Int) Int
  if n <= 0
    return 0
  end
  return recurse(n - 1) + 1
end

fun fail_write(block: Memory.Block, error: Memory.Error) Result(U8, Memory.Error)
  deallocate(block)
  return Err(error)
end

fun fail_read(block: Memory.Block, error: Memory.Error) Result(U8, Memory.Error)
  deallocate(block)
  return Err(error)
end

fun memory_roundtrip() Result(U8, Memory.Error)
  val block = match allocate(1)
    Ok(b) => b
    Err(error) => return Err(error)
  end

  val w = write_u8(&block, 0, PROBE_BYTE)
  match w
    Ok(Unit) => Unit
    Err(error) => return fail_write(block, error)
  end

  val r = read_u8(&block, 0)
  val value = match r
    Ok(v) => v
    Err(error) => return fail_read(block, error)
  end

  deallocate(block)
  return Ok(value)
end

pub fun main() Int
  val depth = recurse(PROBE_RECURSE_DEPTH)

  val mem = match memory_roundtrip()
    Ok(v) => v
    Err(error) => PROBE_FAIL_BYTE
  end

  if mem == PROBE_BYTE
    return depth
  end

  return depth + 1
end
