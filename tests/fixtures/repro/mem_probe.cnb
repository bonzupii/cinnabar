pub mod Memory
  pub nat type Block
  pub type Error
    pub AllocationFailed(Usize)
    pub AccessOutOfBounds(Usize, Usize)
  end
  pub nat fun allocate(size: Usize) impure Result(Block, Error)
  pub nat fun deallocate(block: Block) impure Unit
  pub nat fun write_u8(block: &Block, offset: Usize, value: U8) impure Result(Unit, Error)
  pub nat fun read_u8(block: &Block, offset: Usize) impure Result(U8, Error)
end

pub mod Collections
  pub nat type Vec(T)
  pub type Error
    pub AllocationFailed(Usize)
    pub IndexOutOfBounds(Usize)
  end
  pub nat fun vec_new<T>() impure Result(Vec(T), Error)
  pub nat fun vec_push<T>(vec: &mut Vec(T), value: T) impure Result(Unit, Error)
  pub nat fun vec_view<T>(vec: &Vec(T)) &[T]
  pub nat fun vec_free<T>(vec: Vec(T)) impure Unit
end

use Memory.allocate
use Memory.deallocate
use Memory.write_u8
use Memory.read_u8
use Collections.vec_new
use Collections.vec_push
use Collections.vec_view
use Collections.vec_free

pub mod Slice
  pub nat fun len<T>(view: &[T]) Usize
end

use Slice.len as slice_len

# The O(1) call-stack guarantee requires self-recursion to be tail
# recursive (non-tail self-recursion is a compile error), so `recurse`
# carries an accumulator.  The probe runs 500000 tail-recursive frames,
# each performing an opaque heap read so the optimizer cannot collapse
# the recursion into a loop.  This is the post-guard regression: the
# frames must run in O(1) stack via tail-call elimination and the
# process must exit 0 — where the retired dynamic guard used to fire
# with exit 70 (`EX_SOFTWARE`) when recursion consumed the process
# stack.
#
# The harness asserts EXPECT_OK("mem_probe", 0).
const PROBE_RECURSE_DEPTH: I64 = 500000

pub const PROBE_BYTE: U8 = 0x42
pub const PROBE_FAIL_BYTE: U8 = 0xFF

const ZERO_USIZE: Usize = 0

# Tail-recursive depth probe: each level reads a byte (0x42) from the
# block and folds 1 into the accumulator, so a fully-successful run of
# PROBE_RECURSE_DEPTH levels yields exactly PROBE_RECURSE_DEPTH.
fun recurse(n: I64, acc: I64, block: &Memory.Block) impure I64
  if n <= 0
    return acc
  end
  val byte = match read_u8(block, ZERO_USIZE)
    Ok(value) => value
    Err(error) => PROBE_FAIL_BYTE
  end
  if byte == PROBE_BYTE
    return recurse(n - 1, acc + 1, block)
  end
  return recurse(n - 1, acc + 2, block)
end

fun fail_write(block: Memory.Block, error: Memory.Error) impure Result(U8, Memory.Error)
  deallocate(block)
  return Err(error)
end

# The probe block must be *written* before `recurse` reads it.
#
# This fixture used to recurse over a block it had only allocated, and
# passed: `Memory.allocate` lowered to `malloc`, LLVM knows freshly
# malloc'd memory is undef, and it folded the `byte == PROBE_BYTE` test to
# whichever branch it liked -- which happened to be the one the expected
# exit code wanted. The test was reading uninitialized memory and depending
# on how the optimizer resolved the undefined behaviour.
#
# Milestone 4 lowers `allocate` to `mmap`, whose anonymous pages arrive
# genuinely zero-filled, and the read then returns a real 0 rather than a
# convenient undef. Seeding the byte is what the probe always meant to do:
# the point is 500000 tail-recursive frames each performing an opaque heap
# read, not what an unwritten byte happens to contain.
fun seed_probe_byte(block: &Memory.Block) impure Bool
  match write_u8(block, ZERO_USIZE, PROBE_BYTE)
    Ok(Unit) => return true
    Err(error) => return false
  end
end

fun fail_read(block: Memory.Block, error: Memory.Error) impure Result(U8, Memory.Error)
  deallocate(block)
  return Err(error)
end

fun memory_roundtrip() impure Result(U8, Memory.Error)
  val block = match allocate(1)
    Ok(b) => b
    Err(error) => return Err(error)
  end

  val w = write_u8(&block, 0, PROBE_BYTE)
  match w
    Ok(Unit) => Unit
    Err(error) => return fail_write(block, error)
  end

  val r = read_u8(&block, 0)
  val value = match r
    Ok(v) => v
    Err(error) => return fail_read(block, error)
  end

  deallocate(block)
  return Ok(value)
end

pub fun main() impure I64
  val block = match allocate(1)
    Ok(value) => value
    Err(error) => return 1
  end
  if !seed_probe_byte(&block)
    deallocate(block)
    return 1
  end
  val depth = recurse(PROBE_RECURSE_DEPTH, 0, &block)
  deallocate(block)

  val mem = match memory_roundtrip()
    Ok(v) => v
    Err(error) => PROBE_FAIL_BYTE
  end

  if mem == PROBE_BYTE && depth == PROBE_RECURSE_DEPTH
    return 0
  end

  return 1
end
