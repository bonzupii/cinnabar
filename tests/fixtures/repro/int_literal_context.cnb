pub const I32_MIN: I32 = -2147483647 - 1

fun check_i32() I64
  var wrap_hi: I32 = 2147483647 + 1
  if wrap_hi != I32_WRAP_HI
    return 60
  end
  if I32_WRAP_HI != -2147483648
    return 61
  end

  var v: I32 = 40
  if v != 40
    return 62
  end
  if 40 != v
    return 63
  end

  var twice: I32 = 2 * v
  if twice != 80
    return 64
  end

