#! --------------------------------------------------------------- U64 --
pub const U64_WRAP_HI: U64 = 0xFFFFFFFFFFFFFFFF + 1
pub const U64_WRAP_LO: U64 = 0 - 1

fun check_u64() I64
  var wrap_hi: U64 = 0xFFFFFFFFFFFFFFFF + 1
  if wrap_hi != U64_WRAP_HI
    return 70
  end
  if U64_WRAP_HI != 0
    return 71
  end

  var v: U64 = 40
  if v != 40
    return 72
  end
  if 40 != v
    return 73
  end

  var twice: U64 = 2 * v
  if twice != 80
    return 74
  end

  var nested: U64 = 2 * 3 + 4
  if nested != 10
    return 75
  end

  var one: U64 = 1
  var shifted: U64 = one << 3
  if shifted != 8
    return 76
  end

  #! 0 - 1 wraps to U64's max, which is only orderable as an unsigned
  #! value: read as signed it would be -1 and compare below 1.
  var wrap_lo: U64 = 0 - 1
  if wrap_lo != U64_WRAP_LO
    return 77
  end

  return 0
end

