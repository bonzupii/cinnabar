#! ------------------------------------------------------------- Isize --
pub const ISIZE_WRAP_HI: Isize = 9223372036854775807 + 1

fun check_isize() I64
  var wrap_hi: Isize = 9223372036854775807 + 1
  if wrap_hi != ISIZE_WRAP_HI
    return 100
  end
  if ISIZE_WRAP_HI != ISIZE_MIN
    return 101
  end

  var v: Isize = 40
  if v != 40
    return 102
  end
  if 40 != v
    return 103
  end

  var twice: Isize = 2 * v
  if twice != 80
    return 104
  end

  var nested: Isize = 2 * 3 + 4
  if nested != 10
    return 105
  end

  var one: Isize = 1
  var shifted: Isize = one << 3
  if shifted != 8
    return 106
  end

  var min: Isize = -9223372036854775807 - 1
  if min != ISIZE_MIN
    return 107
  end

  return 0
end

#! A parameter's declared type is a typed context too, so a bare literal
#! argument adopts it, and a literal compared against the parameter inside
#! the callee adopts the parameter's type in turn.
fun takes_u8(value: U8) I64
  if value != 200
    return 110
  end
  return 0
end

pub fun main() I64
  val r_reported = reported_case()
  if r_reported != 0
    return r_reported
  end

  val r_u8 = check_u8()
  if r_u8 != 0
    return r_u8
  end

  val r_i8 = check_i8()
  if r_i8 != 0
    return r_i8
  end

  val r_u16 = check_u16()
  if r_u16 != 0
    return r_u16
  end

  val r_i16 = check_i16()
  if r_i16 != 0
    return r_i16
  end

  val r_u32 = check_u32()
  if r_u32 != 0
    return r_u32
  end

  val r_i32 = check_i32()
  if r_i32 != 0
    return r_i32
  end

  val r_u64 = check_u64()
  if r_u64 != 0
    return r_u64
  end

  val r_usize = check_usize()
  if r_usize != 0
    return r_usize
  end

  val r_i64 = check_i64()
  if r_i64 != 0
    return r_i64
  end

  val r_isize = check_isize()
  if r_isize != 0
    return r_isize
  end

  val r_param = takes_u8(100 + 100)
  if r_param != 0
    return r_param
  end

  return 0
end
