#! Literal typing context: a `const` and a `var` must type the identical
#! initializer identically, and a bare literal must adopt the type of the
#! operand it is compared against.
#!
#! An integer literal is a width-agnostic magnitude with no type of its
#! own; it adopts the type its context demands and defaults to `I64` only
#! when no context supplies one.  A binary operator supplies that context
#! from two places: the type expected of the whole expression (a `const`'s
#! declared type, a `var`'s annotation, a parameter, a return type) and
#! the peer operand's type when only one side is a bare literal.  A value
#! that already has a type never adopts another one — that would be the
#! implicit conversion `MANIFESTO.md` forbids — so `int_literal_no_peer.cnb`
#! pins the rejections that bound this rule.
#!
#! Before this rule was stated, the two paths disagreed: `fold_const`
#! pushed the declared type into a binary expression's operands, so
#! `pub const ISIZE_MIN: Isize = -9223372036854775807 - 1` typed as Isize,
#! while `check_binary` typed its operands with no expectation at all, so
#! the same text in `var min: Isize = ...` defaulted both literals to I64
#! and failed to unify against Isize.  For I64 locals it only ever worked
#! by coincidence, because the default width happened to match.  Every
#! block below asserts the folded const and the runtime var agree, so the
#! two implementations of the rule cannot drift apart again.
#!
#! Exit code 0 means every check passed.  A non-zero code names the exact
#! check that failed; each type owns a block of eight codes:
#!
#!   U8    10..17    I8    20..27    U16   30..37    I16   40..47
#!   U32   50..57    I32   60..67    U64   70..77    Usize 80..87
#!   I64   90..97    Isize 100..107
#!
#! Within a block the offsets are, in order: +0 var matches folded const at
#! the width's wrap point, +1 the folded const matches its hand-derived
#! value, +2 literal adopts the peer's type on the right of a comparison,
#! +3 the same with the literal on the left, +4 literal on the left of an
#! arithmetic operator adopts the peer's type, +5 a nested all-literal tree
#! adopts the expected type through every level, +6 a literal shift count
#! adopts the shifted operand's type, +7 var matches folded const at the
#! width's other wrap point.
#!
#! Code 1 is the verbatim reproducer this rule was written for.

#! -- The reported reproducer, verbatim ---------------------------------
pub const ISIZE_MIN: Isize = -9223372036854775807 - 1

fun reported_case() I64
  var min: Isize = -9223372036854775807 - 1
  if min != ISIZE_MIN
    return 1
  end
  return 0
end

#! ---------------------------------------------------------------- U8 --
pub const U8_WRAP_HI: U8 = 255 + 1
pub const U8_WRAP_LO: U8 = 0 - 1

fun check_u8() I64
  var wrap_hi: U8 = 255 + 1
  if wrap_hi != U8_WRAP_HI
    return 10
  end
  if U8_WRAP_HI != 0
    return 11
  end

  var v: U8 = 40
  if v != 40
    return 12
  end
  if 40 != v
    return 13
  end

  var twice: U8 = 2 * v
  if twice != 80
    return 14
  end

  var nested: U8 = 2 * 3 + 4
  if nested != 10
    return 15
  end

  var one: U8 = 1
  var shifted: U8 = one << 3
  if shifted != 8
    return 16
  end

  var wrap_lo: U8 = 0 - 1
  if wrap_lo != U8_WRAP_LO
    return 17
  end

  return 0
end

#! ---------------------------------------------------------------- I8 --
pub const I8_WRAP_HI: I8 = 127 + 1
pub const I8_MIN: I8 = -127 - 1

fun check_i8() I64
  var wrap_hi: I8 = 127 + 1
  if wrap_hi != I8_WRAP_HI
    return 20
  end
  if I8_WRAP_HI != -128
    return 21
  end

  var v: I8 = 40
  if v != 40
    return 22
  end
  if 40 != v
    return 23
  end

  var twice: I8 = 2 * v
  if twice != 80
    return 24
  end

  var nested: I8 = 2 * 3 + 4
  if nested != 10
    return 25
  end

  var one: I8 = 1
  var shifted: I8 = one << 3
  if shifted != 8
    return 26
  end

  var min: I8 = -127 - 1
  if min != I8_MIN
    return 27
  end

  return 0
end

