# [EXPECT REJECTION]
#! A self-tail-recursive call that passes a borrow of a local of the current
#! function.  Marking such a call `tail` would promise the callee never
#! touches the caller's frame while handing it a pointer into that frame,
#! which is undefined behaviour under -O2.  The borrow does not outlive the
#! frame jump, so the call is rejected.  (EXPECT_REJECTED.)

fun recurse(n: I64, last: &I64) I64
  if n <= 0
    return 0
  end

  val current = n
  return recurse(n - 1, &current)
end

fun main() I64
  val root = 0
  return recurse(5, &root)
end
