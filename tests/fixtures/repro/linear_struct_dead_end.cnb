#! Bug-report 2a dead-end lock: a struct containing a linear value is
#! constructible, but extracting the handle and leaving it unconsumed must
#! be rejected -- the moved-out handle still must be consumed.

pub mod Collections
  pub nat type Vec(T)
  pub type Error
    pub AllocationFailed(Usize)
    pub IndexOutOfBounds(Usize)
  end
  pub nat fun vec_new<T>() impure Result(Vec(T), Error)
  pub nat fun vec_free<T>(vec: Vec(T)) impure Unit
end

pub type Holder
  pub vec: Collections.Vec(Int)
end

use Collections.vec_new
use Collections.vec_free

fun make_holder() impure Result(Holder, Collections.Error)
  val v = match vec_new[Int]()
    Ok(value) => value
    Err(error) => return Err(error)
  end
  return Ok(Holder(vec: v))
end

pub fun main() impure Int
  val h = match make_holder()
    Ok(value) => value
    Err(error) => return 1
  end

  val v = h.vec
  return 0
end
