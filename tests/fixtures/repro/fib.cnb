#! fib.cnb
#! Fibonacci and an even-term sum, exercise 2.
#! main returns an I64 that maps directly to the process exit code.

const TEN: I64 = 10

fun fib(n: I64) I64
  var a: I64 = 0
  var b: I64 = 1
  var i: I64 = 0
  while i < n
    val nxt: I64 = a + b
    a = b
    b = nxt
    i = i + 1
  end
  return a
end

fun sum_even_fib_below(cap: I64) I64
  var sum: I64 = 0
  var a: I64 = 1
  var b: I64 = 1
  while b < cap
    if (b & 1) == 0
      sum = sum + b
    end
    val nxt: I64 = a + b
    a = b
    b = nxt
  end
  return sum
end

pub fun main() I64
  return fib(TEN) + sum_even_fib_below(4000000)
end
