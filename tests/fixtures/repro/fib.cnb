#! fib.cnb
#! Fibonacci (self-tail-recursive accumulator) and an even-term sum,
#! exercise 2. main returns an I64 that maps directly to the exit code.

const TEN: I64 = 10

fun fib_iter(n: I64, a: I64, b: I64) I64
  if n <= 0
    return a
  end
  return fib_iter(n - 1, b, a + b)
end

fun fib(n: I64) I64
  return fib_iter(n, 0, 1)
end

fun sum_even_fib_below(cap: I64) I64
  var sum: I64 = 0
  var a: I64 = 1
  var b: I64 = 1
  while b < cap
    if (b & 1) == 0
      sum = sum + b
    end
    val nxt: I64 = a + b
    a = b
    b = nxt
  end
  return sum
end

fun main() I64
  return fib(TEN) + sum_even_fib_below(4000000)
end
