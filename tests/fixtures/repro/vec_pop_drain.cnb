#! vec_pop is the Vec extraction surface (the Resolvability Rule): a
#! linear element pushed into the Vec is popped back out by value and its
#! linear obligation transfers to the caller, where deallocate consumes
#! it.  A `while true` drain loop exits only through vec_pop's
#! Err(IndexOutOfBounds) arm, which proves the container drained, so
#! vec_free after the loop is legal.  Error paths consume the Vec through
#! the fail_vec_free helper, which drains whatever the Vec holds before
#! freeing (MANIFESTO: error paths must free linear values before
#! returning).

pub mod Collections
  pub nat type Vec(T)

  pub type Error
    pub AllocationFailed(Usize)
    pub IndexOutOfBounds(Usize, Usize)
  end

  pub nat fun vec_new<T>() impure Result(Vec(T), Error)
  pub nat fun vec_push<T>(vec: &mut Vec(T), value: T) impure Result(Unit, Error)
  pub nat fun vec_pop<T>(vec: &mut Vec(T)) impure Result(T, Error)
  pub nat fun vec_free<T>(vec: Vec(T)) impure Unit
end

pub mod Memory
  pub nat type Block
  pub type Error
    pub AllocationFailed(Usize)
  end
  pub nat fun allocate(size: Usize) impure Result(Block, Error)
  pub nat fun deallocate(block: Block) impure Unit
end

use Collections.vec_new
use Collections.vec_push
use Collections.vec_pop
use Collections.vec_free
use Collections.Vec
use Memory.allocate
use Memory.deallocate

fun fail_vec_free(vec: Collections.Vec(Memory.Block)) impure I64
  while true
    match vec_pop(&mut vec)
      Ok(elem) => deallocate(elem)
      Err(error) => break
    end
  end
  vec_free(vec)
  return 1
end

pub fun main() impure I64
  val vec = match vec_new[Memory.Block]()
    Ok(v) => v
    Err(error) => return 1
  end

  val block = match allocate(64)
    Ok(b) => b
    Err(error) => return fail_vec_free(vec)
  end

  match vec_push(&mut vec, block)
    Ok(v) => v
    Err(error) => return fail_vec_free(vec)
  end

  while true
    match vec_pop(&mut vec)
      Ok(elem) => deallocate(elem)
      Err(error) => break
    end
  end

  vec_free(vec)
  return 0
end
