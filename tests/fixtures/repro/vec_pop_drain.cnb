#! vec_pop is the Vec extraction surface: a linear element pushed into the
#! Vec is popped back out by value and its linear obligation transfers to
#! the caller.  The block's byte is written from the runtime argument
#! count and read back through the popped element, so the heap buffer
#! carries a runtime value that -O2 dead-allocation elimination cannot
#! fold away.

pub mod Collections
  pub nat type Vec(T)
  pub nat type String

  pub type Error
    pub AllocationFailed(Usize)
    pub IndexOutOfBounds(Usize, Usize)
  end

  pub nat fun vec_new<T>() impure Result(Vec(T), Error)
  pub nat fun vec_push<T>(vec: &mut Vec(T), value: T) impure Result(Unit, Error)
  pub nat fun vec_pop<T>(vec: &mut Vec(T)) impure Result(T, Error)
  pub nat fun vec_free<T>(vec: Vec(T)) impure Unit
end

pub mod Memory
  pub nat type Block
  pub type Error
    pub AllocationFailed(Usize)
    pub AccessOutOfBounds(Usize, Usize)
  end
  pub nat fun allocate(size: Usize) impure Result(Block, Error)
  pub nat fun deallocate(block: Block) impure Unit
  pub nat fun write_u8(block: &Block, offset: Usize, value: U8) impure Result(Unit, Error)
  pub nat fun read_u8(block: &Block, offset: Usize) impure Result(U8, Error)
end

pub mod Runtime
  pub nat fun args() &[Collections.String]
end

pub mod Slice
  pub nat fun len<T>(view: &[T]) Usize
end

use Collections.vec_new
use Collections.vec_push
use Collections.vec_pop
use Collections.vec_free
use Memory.allocate
use Memory.deallocate
use Memory.write_u8
use Memory.read_u8
use Runtime.args
use Slice.len as slice_len

fun fail_block(block: Memory.Block) impure I64
  deallocate(block)
  return 1
end

fun fail_vec_free(vec: Collections.Vec(Memory.Block)) impure I64
  while true
    match vec_pop(&mut vec)
      Ok(elem) => deallocate(elem)
      Err(error) => break
    end
  end
  vec_free(vec)
  return 1
end

fun observe(block: Memory.Block, want: U8) impure I64
  val byte = match read_u8(&block, 0)
    Ok(value) => value
    Err(error) => 0xFF
  end
  deallocate(block)
  if byte == want
    return 0
  end
  return 1
end

pub fun main() impure I64
  val want: U8 = U8.from(slice_len(args()))
  val block = match allocate(1)
    Ok(b) => b
    Err(error) => return 1
  end

  match write_u8(&block, 0, want)
    Ok(v) => v
    Err(error) => return fail_block(block)
  end

  val vec = match vec_new[Memory.Block]()
    Ok(v) => v
    Err(error) => return fail_block(block)
  end

  match vec_push(&mut vec, block)
    Ok(v) => v
    Err(error) => return fail_vec_free(vec)
  end

  var result: I64 = 1
  while true
    match vec_pop(&mut vec)
      Ok(elem) => result = observe(elem, want)
      Err(error) => break
    end
  end

  vec_free(vec)
  return result
end
