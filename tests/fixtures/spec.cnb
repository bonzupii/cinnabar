#!|
  Cinnabar Language Specification & Reference Implementation (Version 1).

  This program is the normative executable reference for the Cinnabar language.
  It exercises every language feature in full: modules, traits, generics,
  fixed-size arrays, slices, rest patterns, growable collections, bitwise and
  modulo math, opaque native memory/terminal handles, explicit Result handling,
  explicit Option handling, structs, enums, visibility, imports, loop control,
  if/elif/else branching, comment forms, and compiler-enforced casing.

  Language Rules Summary:
  - Casing:
      - functions, val names, and var names: snake_case
      - types, traits, modules, enum variants: PascalCase
      - constants: SCREAMING_SNAKE_CASE
  - Bindings:
      - const: compile-time constant
      - val: immutable local binding
      - var: mutable local binding
  - Borrowing & Memory:
      - &T is a shared borrow
      - &mut T is an exclusive mutable borrow
      - borrow scopes are flow-sensitive and cannot outlive the owner
      - no lifetime annotations exist; ambiguous returned borrows are compiler errors
      - linear handles (Memory.Block, Vec, String, HashMap) must be consumed exactly once
  - Generics:
      - type constructors use parentheses: Vec(T)
      - function type parameters use angle brackets: fun f<T>
      - explicit call-site instantiation uses square brackets: f[U8]()
      - return-type-only type parameters are inferred from call context
  - Control Flow & Operators:
      - if, elif, else branching
      - while loops with break and continue
      - try operator for Result and Option
      - arithmetic (+, -, *, /, %), bitwise (&, |, ^, <<, >>), logical (&&, ||, !)
      - / and % return Result(T, DivError); a statically-known-zero divisor is a compile error
      - array/slice indexing (arr[i], &arr[i], &mut arr[i]): constant indices proven at compile time; dynamic and slice indices return Result(T, IndexError)
  - Native Surfaces:
      - Runtime, Memory, Binary, Slice, Collections, Terminal
  - Built-in Primitives:
      - Unit, Result(T, E), Option(T), DivError, IndexError are built-in language primitives
      - the integer grid is the ten fixed-width types I8/I16/I32/I64/Isize (signed) and
        U8/U16/U32/U64/Usize (unsigned), plus Bool (i1); Int is retired, so I64 is the sole
        64-bit signed integer and untyped integer literals default to I64
      - every width supports every operator: arithmetic/bitwise wrap per-width (two's
        complement), shift counts mask by width - 1, signed types shift and compare
        arithmetically, unsigned types logically
      - T.from(value) converts any integer to T, selecting trunc/zext/sext from the source
        and destination width and signedness; no implicit conversions exist
      - integer literals are non-negative magnitudes that adopt the expected type in typed
        contexts and are range-checked against its width (300 as U8, -1 as U16, 0x100 as U8
        are errors); unary '-' on an unsigned type is an error
|#

# Line comment: Ignored by the lexer and parser.
#! Line documentation comment: Attaches to the subsequent declaration.
#|
  Block comment: Multi-line comment block.
  Block comments do not nest in Cinnabar.
|#
#!|
  Block documentation comment: Multi-line documentation block
  attaching to the subsequent top-level module or declaration.
|#

#! Compile-time constant declarations enforcing SCREAMING_SNAKE_CASE.
pub const SENTINEL_INT: I64 = 999999 # Trailing comments may follow any line of code.
pub const ZERO_INT: I64 = 0

pub const GOOD_RANGE_INPUT: I64 = 21
pub const SMALL_RANGE_INPUT: I64 = -1
pub const LARGE_RANGE_INPUT: I64 = 101
pub const GOOD_RANGE_OUTPUT: I64 = 42
pub const MAX_RANGE: I64 = 100

pub const GOOD_PORT: I64 = 8080
pub const BAD_PORT: I64 = 0
pub const MIN_PORT: I64 = 1
pub const MAX_PORT: I64 = 65535

pub const EVEN_TWO: I64 = 2
pub const EVEN_FOUR: I64 = 4
pub const HALF_TWO: I64 = 1
pub const HALF_FOUR: I64 = 2

pub const LOOP_LIMIT: I64 = 5
pub const LOOP_EXPECTED: I64 = 10
pub const BREAK_CONTINUE_EXPECTED: I64 = 13
pub const OPTION_TRY_EXPECTED: I64 = 3

pub const POINT_DX: I64 = 3
pub const POINT_DY: I64 = 4

pub const FLAG_ACTIVE: I64 = 1
pub const FLAG_ADMIN: I64 = 2

pub const MAGIC_U32: U32 = 0x0BADF00D
pub const SENTINEL_U32: U32 = 0xFFFFFFFF

pub const MAGIC_BYTE_0: U8 = 0x0D
pub const MAGIC_BYTE_1: U8 = 0xF0
pub const MAGIC_BYTE_2: U8 = 0xAD
pub const MAGIC_BYTE_3: U8 = 0x0B

pub const STRING_BYTE_0: U8 = 0x48 # UTF-8 'H'
pub const STRING_BYTE_1: U8 = 0x65 # UTF-8 'e'
pub const STRING_BYTE_2: U8 = 0x6C # UTF-8 'l'
pub const STRING_BYTE_3: U8 = 0x6C # UTF-8 'l'
pub const STRING_BYTE_4: U8 = 0x6F # UTF-8 'o'
pub const STRING_BYTE_5: U8 = 0x20 # UTF-8 ' '
pub const STRING_BYTE_6: U8 = 0x43 # UTF-8 'C'
pub const STRING_BYTE_7: U8 = 0x69 # UTF-8 'i'
pub const STRING_BYTE_8: U8 = 0x6E # UTF-8 'n'
pub const STRING_BYTE_9: U8 = 0x6E # UTF-8 'n'
pub const STRING_BYTE_10: U8 = 0x61 # UTF-8 'a'
pub const STRING_BYTE_11: U8 = 0x62 # UTF-8 'b'
pub const STRING_BYTE_12: U8 = 0x61 # UTF-8 'a'
pub const STRING_BYTE_13: U8 = 0x72 # UTF-8 'r'
pub const STRING_BYTE_14: U8 = 0x21 # UTF-8 '!'

pub const MEMORY_BYTE: U8 = 0xA5
pub const MEMORY_SIZE: Usize = 1
pub const ZERO_USIZE: Usize = 0
pub const ONE_USIZE: Usize = 1
pub const SENTINEL_USIZE: Usize = 999999

pub const EXPECTED_REST_LEN: Usize = 3
pub const EXPECTED_STRING_LEN: Usize = 15

pub const OOB_INDEX: Usize = 99

pub const HEADER_KIND: U32 = 7
pub const HEADER_FLAGS: U32 = 3
pub const TAG_VALUE: U32 = 0x5A
pub const CHECKSUM_SALT: U32 = 0x0F

pub const EXPECTED_HEADER_CHECKSUM: U32 = 0x00070304
pub const EXPECTED_TAG_CHECKSUM: U32 = 0x00000055

#! User-defined sum-type enum representing program exit statuses.
pub type ExitCode
  pub ExitSuccess
  pub ExitFailure
  pub ExitDiagnostic(I64)
end

#! Enum variants demonstrating payload data.
pub type RangeError
  pub TooSmall(I64)
  pub TooLarge(I64)
end

pub type PortError
  pub PortInvalid(I64)
end

#! Nested sum type demonstrating error wrapping.
pub type AppError
  pub AppRange(RangeError)
  pub AppPort(PortError)
end

#! Nominal single-payload struct wrapper.
pub type Port
  pub Port(I64)
end

#! Product type struct demonstrating named fields in PascalCase.
pub type Point
  pub x: I64
  pub y: I64
end

pub type Header
  pub kind: U32
  pub flags: U32
end

pub type Tag
  pub value: U32
end

#! Groups fixed-size byte arrays with expected U32 magic digests.
pub type MagicHeader
  pub bytes: [U8; 4]
  pub expected: U32
end

#! Groups memory test parameters.
pub type MemoryPlan
  pub size: Usize
  pub byte: U8
end

pub type ChecksumExpectation
  pub header: U32
  pub tag: U32
end

#! Demonstrates struct containing slice length metadata.
pub type SplitFirst
  pub first: U8
  pub rest_len: Usize
end

#! Demonstrates nested public module scoping.
pub mod Runtime
  pub type Error
    pub NotReady
    pub ProbeFailed(I64)
  end

  #! Opaque native runtime check surface.
  pub nat fun self_check() impure Result(Unit, Error)

  #! Internal private function.
  fun probe_twice() impure Result(Unit, Error)
    try self_check()
    try self_check()
    return Ok(Unit)
  end

  #! Public gate interface propagating errors with try.
  pub fun gate() impure Result(Unit, Error)
    try probe_twice()
    return Ok(Unit)
  end
end

#|
  Raw Memory Quarantine.

  Demonstrates native linear types (Block) and memory operations.
  Cinnabar user code sees opaque linear Block handles, never raw pointers.
|#
pub mod Memory
  #! Block is a linear handle.
  #! Invariant: Block MUST be consumed exactly once on every execution path.
  pub nat type Block

  pub type Error
    pub AllocationFailed(Usize)
    pub AccessOutOfBounds(Usize, Usize)
  end

  pub nat fun allocate(size: Usize) impure Result(Block, Error)
  pub nat fun deallocate(block: Block) impure Unit
  pub nat fun write_u8(
    block: &Block,
    offset: Usize,
    value: U8
  ) impure Result(Unit, Error)

  pub nat fun read_u8(
    block: &Block,
    offset: Usize
  ) impure Result(U8, Error)
end

#! Binary parsing module.
pub mod Binary
  pub type Error
    pub MagicMismatch(U32)
  end

  # Private bit-shifting helper.
  fun combine_le_bytes(b0: U8, b1: U8, b2: U8, b3: U8) U32
    val v0 = U32.from(b0)
    val v1 = U32.from(b1)
    val v2 = U32.from(b2)
    val v3 = U32.from(b3)

    return (v3 << 24) | (v2 << 16) | (v1 << 8) | v0
  end

  # Private helper demonstrating array pattern destructuring.
  fun u32_from_le_bytes(bytes: [U8; 4]) U32
    match bytes
      [b0, b1, b2, b3] => return combine_le_bytes(b0, b1, b2, b3)
    end
  end

  pub fun check_magic(header: &MagicHeader) Result(Unit, Error)
    val value = u32_from_le_bytes(header.bytes)

    if value == header.expected
      return Ok(Unit)
    end

    return Err(MagicMismatch(value))
  end
end

#! Slice operations module.
pub mod Slice
  pub nat fun len<T>(view: &[T]) Usize
end

#! Standard growable collection surfaces required for self-hosting.
pub mod Collections
  pub nat type Vec(T)
  pub nat type String
  pub nat type HashMap(K, V)

  pub type Error
    pub AllocationFailed(Usize)
    pub IndexOutOfBounds(Usize)
    pub KeyNotFound
    pub EmptySlice
    pub InvalidUtf8
  end

  pub nat fun vec_new<T>() impure Result(Vec(T), Error)
  pub nat fun vec_push<T>(
    vec: &mut Vec(T),
    value: T
  ) impure Result(Unit, Error)

  pub nat fun vec_view<T>(vec: &Vec(T)) &[T]
  pub nat fun vec_free<T>(vec: Vec(T)) impure Unit

  pub nat fun string_from_slice(view: &[U8]) impure Result(String, Error)
  pub nat fun string_len(value: &String) Usize
  pub nat fun string_free(value: String) impure Unit

  pub nat fun hash_map_new<K, V>() impure Result(HashMap(K, V), Error)
  pub nat fun hash_map_insert<K, V>(
    map: &mut HashMap(K, V),
    key: K,
    value: V
  ) impure Result(Unit, Error)

  pub nat fun hash_map_get<K, V>(
    map: &HashMap(K, V),
    key: K
  ) impure Result(V, Error)

  pub nat fun hash_map_free<K, V>(map: HashMap(K, V)) impure Unit
end

#! Native Terminal I/O surface for stdout, stderr, and line input.
pub mod Terminal
  pub nat fun print(text: &Collections.String) impure Unit
  pub nat fun print_line(text: &Collections.String) impure Unit
  pub nat fun eprint(text: &Collections.String) impure Unit
end

#! Explicit import declarations and aliasing (`as`).
use Runtime.gate
use Memory.allocate
use Memory.deallocate
use Memory.write_u8
use Memory.read_u8
use Binary.check_magic as verify_magic
use Slice.len as slice_len
use Collections.vec_new
use Collections.vec_push
use Collections.vec_view
use Collections.vec_free
use Collections.string_from_slice
use Collections.string_len
use Collections.string_free
use Collections.hash_map_new
use Collections.hash_map_insert
use Collections.hash_map_get
use Collections.hash_map_free
use Terminal.print_line

pub trait Checksum
  pub fun checksum(value: &Self) U32
end

pub impl Checksum for Header
  pub fun checksum(value: &Header) U32
    return ((value.kind << 16) ^ (value.flags << 8) ^ value.kind ^ value.flags)
  end
end

pub impl Checksum for Tag
  pub fun checksum(value: &Tag) U32
    return value.value ^ CHECKSUM_SALT
  end
end

#! Bounded generic function constrained by trait Checksum.
fun checksum_value<T: Checksum>(value: &T) U32
  return Checksum.checksum(value)
end

fun magic_header() MagicHeader
  return MagicHeader(
    bytes: [MAGIC_BYTE_0, MAGIC_BYTE_1, MAGIC_BYTE_2, MAGIC_BYTE_3],
    expected: MAGIC_U32
  )
end

fun memory_plan() MemoryPlan
  return MemoryPlan(
    size: MEMORY_SIZE,
    byte: MEMORY_BYTE
  )
end

fun checksum_expectation() ChecksumExpectation
  return ChecksumExpectation(
    header: EXPECTED_HEADER_CHECKSUM,
    tag: EXPECTED_TAG_CHECKSUM
  )
end

#!|
  `/` and `%` on I64 use Euclidean division: the remainder is always
  non-negative (0 <= r < abs(divisor)), regardless of operand signs.
     -10 / 3 = -4    -10 % 3 = 2
      10 / -3 = -3    10 % -3 = 1
|#

#! Demonstrates modulo returning Result(I64, DivError).
fun modulo_demo(value: I64, divisor: I64) Result(I64, DivError)
  return value % divisor
end

#! Demonstrates division returning Result(I64, DivError).
fun div_demo(value: I64, divisor: I64) Result(I64, DivError)
  return value / divisor
end

#! Demonstrates `if`, `elif`, and `else` conditional branching chains.
fun port_from_int(value: I64) Result(Port, PortError)
  if value < MIN_PORT
    return Err(PortInvalid(value))
  elif value > MAX_PORT
    return Err(PortInvalid(value))
  else
    return Ok(Port(value))
  end
end

fun port_value(port: Port) I64
  match port
    Port(value) => return value
  end
end

fun normalize(value: I64) Result(I64, RangeError)
  if value < ZERO_INT
    return Err(TooSmall(value))
  elif value > MAX_RANGE
    return Err(TooLarge(value))
  else
    return Ok(value)
  end
end

fun double_positive(value: I64) Result(I64, RangeError)
  if value < ZERO_INT
    return Err(TooSmall(value))
  end

  return Ok(value + value)
end

fun range_workflow(input: I64) Result(I64, RangeError)
  val normalized = try normalize(input)
  val doubled = try double_positive(normalized)
  return Ok(doubled)
end

fun range_to_app(error: RangeError) AppError
  match error
    TooSmall(value) => return AppRange(TooSmall(value))
    TooLarge(value) => return AppRange(TooLarge(value))
  end
end

fun app_workflow(input: I64) Result(I64, AppError)
  val normalized = match normalize(input)
    Ok(value) => value
    Err(error) => return Err(range_to_app(error))
  end

  val doubled = match double_positive(normalized)
    Ok(value) => value
    Err(error) => return Err(range_to_app(error))
  end

  return Ok(doubled)
end

fun half_if_even(value: I64) Option(I64)
  if value == EVEN_TWO
    return Some(HALF_TWO)
  elif value == EVEN_FOUR
    return Some(HALF_FOUR)
  else
    return None
  end
end

fun sum_to(limit: I64) I64
  var total: I64 = ZERO_INT
  var i: I64 = ZERO_INT

  while i < limit
    total = total + i
    i = i + 1
  end

  return total
end

fun break_continue_demo() I64
  var total: I64 = ZERO_INT
  var i: I64 = ZERO_INT

  while true
    if i >= LOOP_LIMIT
      break
    end

    i = i + 1

    if i == EVEN_TWO
      continue
    end

    total = total + i
  end

  return total
end

fun option_try_demo() Option(I64)
  val half = try half_if_even(EVEN_FOUR)
  return Some(half + HALF_TWO)
end

fun move_point(point: Point, dx: I64, dy: I64) Point
  return Point(x: point.x + dx, y: point.y + dy)
end

#! Mutates a Point's fields in place through a &mut reference.
fun mutate_point(point: &mut Point, dx: I64, dy: I64) Unit
  point.x = point.x + dx
  point.y = point.y + dy
  return Unit
end

#! Writes one field of a dynamically-indexed element of a fixed-size
#! array through a &mut borrow, unwrapped with try in the assignment
#! target.  Dynamic array indexing is runtime-checked, so the try can
#! propagate IndexError; the returned Bool reports whether the write
#! actually landed on the element.
fun mutate_point_array(index: Usize, value: I64) Result(Bool, IndexError)
  var points = [Point(x: 1, y: 2), Point(x: 3, y: 4)]

  (try &mut points[index]).x = value

  val changed = points[0].x == 1 && points[1].x == value
  return Ok(changed)
end

#! Exercises field assignment through mutable references: a &mut local
#! binding, a &mut parameter, and a &mut-borrowed array element reached
#! through dynamic indexing.
fun check_mut_ref() Bool
  var pt = Point(x: 1, y: 2)
  val ref_pt = &mut pt
  ref_pt.x = 10
  ref_pt.y = 20

  val array_ok = match mutate_point_array(ONE_USIZE, 100)
    Ok(changed) => changed
    Err(IndexOutOfBounds(index, length)) =>
      index == SENTINEL_USIZE && length == SENTINEL_USIZE
  end

  mutate_point(&mut pt, 1, 2)

  if pt.x == 11 && pt.y == 22 && array_ok
    return true
  end

  return false
end

#! Reads a Point through a shared borrow; consumes `&arr[i]`.
fun point_sum(value: &Point) I64
  return value.x + value.y
end

fun use_memory_block(block: Memory.Block, plan: &MemoryPlan) impure Result(U8, Memory.Error)
  val write_result = write_u8(&block, ZERO_USIZE, plan.byte)

  val read_result = match write_result
    Ok(Unit) => read_u8(&block, ZERO_USIZE)
    Err(error) => Err(error)
  end

  deallocate(block)
  return read_result
end

fun memory_roundtrip(plan: &MemoryPlan) impure Result(U8, Memory.Error)
  val block = try allocate(plan.size)
  return use_memory_block(block, plan)
end

fun fail_free_vec<T>(vec: Collections.Vec(U8), error: Collections.Error) impure Result(T, Collections.Error)
  vec_free(vec)
  return Err(error)
end

fun fail_free_map<T>(map: Collections.HashMap(U8, U8), error: Collections.Error) impure Result(T, Collections.Error)
  hash_map_free(map)
  return Err(error)
end

fun push_all_magic(vec: &mut Collections.Vec(U8)) impure Result(Unit, Collections.Error)
  try vec_push(vec, MAGIC_BYTE_0)
  try vec_push(vec, MAGIC_BYTE_1)
  try vec_push(vec, MAGIC_BYTE_2)
  try vec_push(vec, MAGIC_BYTE_3)
  return Ok(Unit)
end

fun push_string_bytes(vec: &mut Collections.Vec(U8)) impure Result(Unit, Collections.Error)
  try vec_push(vec, STRING_BYTE_0)
  try vec_push(vec, STRING_BYTE_1)
  try vec_push(vec, STRING_BYTE_2)
  try vec_push(vec, STRING_BYTE_3)
  try vec_push(vec, STRING_BYTE_4)
  try vec_push(vec, STRING_BYTE_5)
  try vec_push(vec, STRING_BYTE_6)
  try vec_push(vec, STRING_BYTE_7)
  try vec_push(vec, STRING_BYTE_8)
  try vec_push(vec, STRING_BYTE_9)
  try vec_push(vec, STRING_BYTE_10)
  try vec_push(vec, STRING_BYTE_11)
  try vec_push(vec, STRING_BYTE_12)
  try vec_push(vec, STRING_BYTE_13)
  try vec_push(vec, STRING_BYTE_14)
  return Ok(Unit)
end


fun split_first(view: &[U8]) Option(SplitFirst)
  match view
    [] => return None
    [first, rest @ ..] =>
      return Some(SplitFirst(first: first, rest_len: slice_len(rest)))
  end
end

fun vec_demo() impure Result(SplitFirst, Collections.Error)
  val vec = try vec_new[U8]()

  val push_result = push_all_magic(&mut vec)
  match push_result
    Ok(Unit) => Unit
    Err(error) => return fail_free_vec(vec, error)
  end

  val view = vec_view(&vec)
  val split = split_first(view)

  val result = match split
    Some(value) => Ok(value)
    None => Err(Collections.EmptySlice)
  end

  vec_free(vec)
  return result
end

#! Demonstrates String construction and Terminal printing.
fun string_demo() impure Result(Usize, Collections.Error)
  val vec = try vec_new[U8]()

  val push_result = push_string_bytes(&mut vec)
  match push_result
    Ok(Unit) => Unit
    Err(error) => return fail_free_vec(vec, error)
  end

  val view = vec_view(&vec)
  val string_result = string_from_slice(view)

  val string = match string_result
    Ok(value) => value
    Err(error) => return fail_free_vec(vec, error)
  end

  val length = string_len(&string)

  # Exercise native terminal printing
  print_line(&string)

  string_free(string)
  vec_free(vec)
  return Ok(length)
end

fun hash_map_demo() impure Result(U8, Collections.Error)
  val map = try hash_map_new[U8, U8]()

  val insert_result = hash_map_insert(&mut map, MEMORY_BYTE, MAGIC_BYTE_0)
  match insert_result
    Ok(Unit) => Unit
    Err(error) => return fail_free_map(map, error)
  end

  val get_result = hash_map_get(&map, MEMORY_BYTE)
  val value = match get_result
    Ok(found) => found
    Err(error) => return fail_free_map(map, error)
  end

  hash_map_free(map)
  return Ok(value)
end

fun check_range_workflow() Bool
  val good = range_workflow(GOOD_RANGE_INPUT)
  val bad_small = range_workflow(SMALL_RANGE_INPUT)
  val bad_large = range_workflow(LARGE_RANGE_INPUT)

  val good_ok = match good
    Ok(value) => value == GOOD_RANGE_OUTPUT
    Err(TooSmall(value)) => value == SENTINEL_INT
    Err(TooLarge(value)) => value == SENTINEL_INT
  end

  val small_ok = match bad_small
    Ok(value) => value == SENTINEL_INT
    Err(TooSmall(value)) => value == SMALL_RANGE_INPUT
    Err(TooLarge(value)) => value == SENTINEL_INT
  end

  val large_ok = match bad_large
    Ok(value) => value == SENTINEL_INT
    Err(TooSmall(value)) => value == SENTINEL_INT
    Err(TooLarge(value)) => value == LARGE_RANGE_INPUT
  end

  return good_ok && small_ok && large_ok
end

fun check_app_workflow() Bool
  val good = app_workflow(GOOD_RANGE_INPUT)
  val bad = app_workflow(SMALL_RANGE_INPUT)

  val good_ok = match good
    Ok(value) => value == GOOD_RANGE_OUTPUT
    Err(AppRange(TooSmall(value))) => value == SENTINEL_INT
    Err(AppRange(TooLarge(value))) => value == SENTINEL_INT
    Err(AppPort(PortInvalid(value))) => value == SENTINEL_INT
  end

  val bad_ok = match bad
    Ok(value) => value == SENTINEL_INT
    Err(AppRange(TooSmall(value))) => value == SMALL_RANGE_INPUT
    Err(AppRange(TooLarge(value))) => value == SENTINEL_INT
    Err(AppPort(PortInvalid(value))) => value == SENTINEL_INT
  end

  return good_ok && bad_ok
end

fun check_port() Bool
  val good = port_from_int(GOOD_PORT)
  val bad = port_from_int(BAD_PORT)

  val good_ok = match good
    Ok(port) => port_value(port) == GOOD_PORT
    Err(PortInvalid(value)) => value == SENTINEL_INT
  end

  val bad_ok = match bad
    Ok(port) => port_value(port) == SENTINEL_INT
    Err(PortInvalid(value)) => value == BAD_PORT
  end

  return good_ok && bad_ok
end

fun check_option() Bool
  val even = half_if_even(EVEN_TWO)
  val odd = half_if_even(EVEN_TWO + 1)

  val even_ok = match even
    Some(value) => value == HALF_TWO
    None => false
  end

  val odd_ok = match odd
    Some(value) => value == SENTINEL_INT
    None => true
  end

  return even_ok && odd_ok
end

fun check_option_try() Bool
  val result = option_try_demo()

  match result
    Some(value) => return value == OPTION_TRY_EXPECTED
    None => return false
  end
end

fun check_loop() Bool
  return sum_to(LOOP_LIMIT) == LOOP_EXPECTED
end

fun check_break_continue() Bool
  return break_continue_demo() == BREAK_CONTINUE_EXPECTED
end

fun check_struct() Bool
  val origin = Point(x: ZERO_INT, y: ZERO_INT)
  val moved = move_point(origin, POINT_DX, POINT_DY)

  return moved.x == POINT_DX && moved.y == POINT_DY
end

fun check_flags() Bool
  val flags = FLAG_ACTIVE | FLAG_ADMIN

  val active = (flags & FLAG_ACTIVE) != ZERO_INT
  val admin = (flags & FLAG_ADMIN) != ZERO_INT

  return active && admin
end

fun check_modulo() Bool
  val rem1 = match modulo_demo(10, 3)
    Ok(rem) => rem
    Err(DivByZero) => SENTINEL_INT
  end

  val rem2 = match modulo_demo(14, 5)
    Ok(rem) => rem
    Err(DivByZero) => SENTINEL_INT
  end

  return rem1 == 1 && rem2 == 4
end

fun check_div() Bool
  val q1 = match div_demo(21, 3)
    Ok(quotient) => quotient
    Err(DivByZero) => SENTINEL_INT
  end

  val q2 = match div_demo(21, 5)
    Ok(quotient) => quotient
    Err(DivByZero) => SENTINEL_INT
  end

  return q1 == 7 && q2 == 4
end

fun check_memory() impure Bool
  val plan = memory_plan()
  val result = memory_roundtrip(&plan)

  match result
    Ok(value) => return value == plan.byte
    Err(Memory.AllocationFailed(size)) => return size == SENTINEL_USIZE
    Err(Memory.AccessOutOfBounds(offset, size)) =>
      return offset == SENTINEL_USIZE && size == SENTINEL_USIZE
  end
end

fun check_binary() Bool
  val header = magic_header()
  val result = verify_magic(&header)

  match result
    Ok(Unit) => return true
    Err(Binary.MagicMismatch(found)) => return found == SENTINEL_U32
  end
end

#! Runtime-checked slice indexing: `view[index]` returns Result(U8,
#! IndexError), landing in Ok for in-bounds reads and in
#! Err(IndexOutOfBounds(index, length)) out of bounds.
fun get_checked(view: &[U8], index: Usize) Result(U8, IndexError)
  return view[index]
end

#! Asserts the in-bounds and out-of-bounds outcomes of dynamic slice
#! indexing are distinct, and that the out-of-bounds error carries the
#! attempted index and the slice's real length.
fun check_indexed(rest: &[U8], b0: U8, first: U8, last: U8) Bool
  val in_ok = match get_checked(rest, 1)
    Ok(value) => value == MAGIC_BYTE_2
    Err(IndexOutOfBounds(index, length)) =>
      index == SENTINEL_USIZE && length == SENTINEL_USIZE
  end

  val out_ok = match get_checked(rest, OOB_INDEX)
    Ok(value) => false
    Err(IndexOutOfBounds(index, length)) =>
      index == OOB_INDEX && length == EXPECTED_REST_LEN
  end

  return (b0 == first) && (last == MAGIC_BYTE_3) && in_ok && out_ok
end

#! Demonstrates array/slice indexing.  Constant indices against the
#! fixed-size array are proven in range at compile time and evaluate
#! directly to the element type with no Result wrapper; dynamic indexing
#! over a slice (from the rest pattern) is runtime-checked.
fun check_index() Bool
  val arr = [MAGIC_BYTE_0, MAGIC_BYTE_1, MAGIC_BYTE_2, MAGIC_BYTE_3]

  val first = arr[0]
  val last = arr[3]

  # `&arr[i]` with a constant, in-range index borrows the element: the
  # result is `&Point`, consumed here through a `&Point` parameter.
  val points = [Point(x: POINT_DX, y: POINT_DY), Point(x: ZERO_INT, y: ZERO_INT)]
  val borrowed_ok = point_sum(&points[0]) == POINT_DX + POINT_DY

  match arr
    [b0, rest @ ..] =>
      return check_indexed(rest, b0, first, last) && borrowed_ok
  end
end

fun check_trait() Bool
  val header = Header(kind: HEADER_KIND, flags: HEADER_FLAGS)
  val tag = Tag(value: TAG_VALUE)
  val expected = checksum_expectation()

  val header_digest = checksum_value(&header)
  val tag_digest = checksum_value(&tag)

  val header_ok = header_digest == expected.header
  val tag_ok = tag_digest == expected.tag
  val distinct = header_digest != tag_digest

  return header_ok && tag_ok && distinct
end

fun check_vec_slice() impure Bool
  val result = vec_demo()

  match result
    Ok(split) =>
      return split.first == MAGIC_BYTE_0 && split.rest_len == EXPECTED_REST_LEN
    Err(Collections.AllocationFailed(size)) => return size == SENTINEL_USIZE
    Err(Collections.IndexOutOfBounds(index)) => return index == SENTINEL_USIZE
    Err(Collections.KeyNotFound) => return false
    Err(Collections.EmptySlice) => return false
    Err(Collections.InvalidUtf8) => return false
  end
end

fun check_string() impure Bool
  val result = string_demo()

  match result
    Ok(length) => return length == EXPECTED_STRING_LEN
    Err(Collections.AllocationFailed(size)) => return size == SENTINEL_USIZE
    Err(Collections.IndexOutOfBounds(index)) => return index == SENTINEL_USIZE
    Err(Collections.KeyNotFound) => return false
    Err(Collections.EmptySlice) => return false
    Err(Collections.InvalidUtf8) => return false
  end
end

fun check_hash_map() impure Bool
  val result = hash_map_demo()

  match result
    Ok(value) => return value == MAGIC_BYTE_0
    Err(Collections.AllocationFailed(size)) => return size == SENTINEL_USIZE
    Err(Collections.IndexOutOfBounds(index)) => return index == SENTINEL_USIZE
    Err(Collections.KeyNotFound) => return false
    Err(Collections.EmptySlice) => return false
    Err(Collections.InvalidUtf8) => return false
  end
end

fun check_collections() impure Bool
  val vec_ok = check_vec_slice()
  val string_ok = check_string()
  val map_ok = check_hash_map()

  return vec_ok && string_ok && map_ok
end

fun reference_checks() impure ExitCode
  val range_ok = check_range_workflow()
  val app_ok = check_app_workflow()
  val port_ok = check_port()
  val option_ok = check_option()
  val option_try_ok = check_option_try()
  val loop_ok = check_loop()
  val break_continue_ok = check_break_continue()
  val struct_ok = check_struct()
  val mut_ref_ok = check_mut_ref()
  val flags_ok = check_flags()
  val modulo_ok = check_modulo()
  val div_ok = check_div()
  val memory_ok = check_memory()
  val binary_ok = check_binary()
  val trait_ok = check_trait()
  val index_ok = check_index()
  val collections_ok = check_collections()

  val all_ok = range_ok && app_ok && port_ok && option_ok && option_try_ok && loop_ok && break_continue_ok && struct_ok && mut_ref_ok && flags_ok && modulo_ok && div_ok && memory_ok && binary_ok && trait_ok && index_ok && collections_ok

  if all_ok
    return ExitSuccess
  end

  return ExitFailure
end

pub fun main() impure ExitCode
  match gate()
    Ok(Unit) => return reference_checks()
    Err(Runtime.NotReady) => return ExitFailure
    Err(Runtime.ProbeFailed(code)) => return ExitDiagnostic(code)
  end
end
