pub mod Net
  pub type Error
    pub SystemFault(I64)
  end

  pub nat type Socket

  pub nat fun socket() impure Result(Socket, Error)
  pub nat fun bind(sock: &Socket, port: Usize) impure Result(Unit, Error)
  pub nat fun listen(sock: &Socket, backlog: Usize) impure Result(Unit, Error)
  pub nat fun accept(sock: &Socket) impure Result(Socket, Error)
  pub nat fun send(sock: &Socket, data: &[U8]) impure Result(Usize, Error)
  pub nat fun close(sock: Socket) impure Unit
end

pub mod Collections
  pub type Error
    pub AllocationFailed(Usize)
    pub IndexOutOfBounds(Usize)
    pub KeyNotFound
    pub EmptySlice
    pub InvalidUtf8
  end

  pub nat type Vec(T)
  pub nat fun vec_new<T>() impure Result(Vec(T), Error)
  pub nat fun vec_push<T>(vec: &mut Vec(T), value: T) impure Result(Unit, Error)
  pub nat fun vec_view<T>(vec: &Vec(T)) &[T]
  pub nat fun vec_free<T>(vec: Vec(T)) impure Unit
end

use Net.socket
use Net.bind
use Net.listen
use Net.accept
use Net.send
use Net.close
use Collections.vec_new
use Collections.vec_push
use Collections.vec_view
use Collections.vec_free

