fun build_response() impure Result(Collections.Vec(U8), Collections.Error)
  val vec = try vec_new[U8]()

  val header_result = push_header(&mut vec)
  match header_result
    Ok(Unit) => Unit
    Err(error) => return fail_free_vec(vec, error)
  end

  val body_result = push_body(&mut vec)
  match body_result
    Ok(Unit) => Unit
    Err(error) => return fail_free_vec(vec, error)
  end

  return Ok(vec)
end

fun fail_start(vec: Collections.Vec(U8), error: Net.Error) impure I64
  vec_free(vec)
  return 2
end

fun fail_serve(listener: Net.Socket, vec: Collections.Vec(U8), error: Net.Error) impure I64
  close(listener)
  vec_free(vec)
  return 3
end

fun fail_conn(listener: Net.Socket, conn: Net.Socket, vec: Collections.Vec(U8), error: Net.Error) impure I64
  close(conn)
  close(listener)
  vec_free(vec)
  return 4
end

pub fun main() impure I64
  val response = match build_response()
    Ok(v) => v
    Err(error) => return 1
  end

  val listener = match socket()
    Ok(s) => s
    Err(error) => return fail_start(response, error)
  end

  val bind_result = bind(&listener, SERVER_PORT)
  match bind_result
    Ok(Unit) => Unit
    Err(error) => return fail_serve(listener, response, error)
  end

  val listen_result = listen(&listener, 1)
  match listen_result
    Ok(Unit) => Unit
    Err(error) => return fail_serve(listener, response, error)
  end

  val conn = match accept(&listener)
    Ok(c) => c
    Err(error) => return fail_serve(listener, response, error)
  end

  val send_result = send(&conn, vec_view(&response))
  match send_result
    Ok(n) => Unit
    Err(error) => return fail_conn(listener, conn, response, error)
  end

  close(conn)
  close(listener)
  vec_free(response)
  return 0
end
