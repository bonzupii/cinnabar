# Required for every checkout. Use an absolute host path and a short,
# lowercase cache key containing only letters, digits, and hyphens.
CINNABAR_WORKTREE=C:/path/to/cinnabar
CINNABAR_CACHE_KEY=main

# The setup script adds these values for a Windows linked worktree. They are
# consumed only when compose.worktree.yaml is selected below.
CINNABAR_GIT_COMMON=C:/path/to/main-checkout/.git
CINNABAR_GIT_POINTER=C:/path/to/config/git-pointer
CINNABAR_GIT_BACKLINK=C:/path/to/config/git-backlink
CINNABAR_GIT_ADMIN=linked-worktree-admin-name

# Which Compose files apply, so no command needs -f arguments. A main checkout
# uses compose.dev.yaml alone; a linked worktree adds compose.worktree.yaml.
# The separator is pinned rather than left to the platform default (';' on
# Windows, ':' elsewhere) so one file means the same thing on either host.
# This example defaults to a main checkout.  For a linked worktree, uncomment
# the second form and fill in the CINNABAR_GIT_* values above: selecting
# compose.worktree.yaml without them bind-mounts the placeholder pointer path
# over /workspace/.git, and Docker creates a missing bind source as an empty
# directory rather than failing, so the container comes up with a broken .git
# instead of an error.  Prefer ./container/configure-worktree.sh, which derives
# all of this from the checkout.
COMPOSE_PATH_SEPARATOR=;
COMPOSE_FILE=compose.dev.yaml
#COMPOSE_FILE=compose.dev.yaml;compose.worktree.yaml
