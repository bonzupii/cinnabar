{
  "name": "cinnabar-site",
  "version": "0.1.0",
  "private": true,
  "description": "Website for Cinnabar, a zero-trust systems language for durable software.",
  "homepage": "https://github.com/bonzupii/cinnabar/tree/main/site",
  "repository": {
    "type": "git",
    "url": "https://github.com/bonzupii/cinnabar.git",
    "directory": "site"
  },
  "bugs": {
    "url": "https://github.com/bonzupii/cinnabar/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "assets": "tsx scripts/generate-brand-assets.tsx && npm run assets:verify",
    "assets:verify": "metaplate verify --size 512x512 public/brand/cinnabar-mark-512-dark.png public/brand/cinnabar-mark-512-light.png --size 1024x1024 public/brand/cinnabar-mark-1024-dark.png public/brand/cinnabar-mark-1024-light.png --size 1024x300 public/brand/cinnabar-wordmark-1024-dark.png public/brand/cinnabar-wordmark-1024-light.png --size 1280x640 public/brand/cinnabar-banner-1280x640-dark.png public/brand/cinnabar-banner-1280x640-light.png --size 128x128 ../editors/vscode/icon.png",
    "prebuild": "npm run assets",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:links": "start-server-and-test \"npx serve out -l 4173\" http://localhost:4173 \"linkinator http://localhost:4173 --recurse --silent --status-code 429:warn\"",
    "test:lighthouse": "lhci autorun",
    "deploy": "netlify deploy --prod",
    "deploy:preview": "netlify deploy"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@uiw/react-codemirror": "^4.25.11",
    "github-slugger": "^2.0.0",
    "motion": "^13.1.0",
    "metaplate": "^0.1.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/github-slugger": "^2.0.0",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "linkinator": "^8.0.1",
    "netlify-cli": "^27.1.1",
    "serve": "^14.2.6",
    "start-server-and-test": "^3.0.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4"
  },
  "overrides": {
    "tmp": "^0.2.7",
    "sharp": "^0.35.3",
    "@opentelemetry/api": "1.8.0"
  }
}
