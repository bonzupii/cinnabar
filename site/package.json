{
  "name": "cinnabar-site",
  "version": "0.1.0",
  "private": true,
  "description": "Website for Cinnabar, a zero-trust systems language for durable software.",
  "homepage": "https://github.com/bonzupii/cinnabar/tree/main/site",
  "repository": {
    "type": "git",
    "url": "https://github.com/bonzupii/cinnabar.git",
    "directory": "site"
  },
  "bugs": {
    "url": "https://github.com/bonzupii/cinnabar/issues"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:links": "start-server-and-test \"npx serve out -l 4173\" http://localhost:4173 \"linkinator http://localhost:4173 --recurse --silent --status-code 429:warn\"",
    "test:lighthouse": "lhci autorun",
    "deploy": "netlify deploy --build --prod",
    "deploy:preview": "netlify deploy --build"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "motion": "^13.1.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/github-slugger": "^1.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "linkinator": "^8.0.1",
    "netlify-cli": "^27.0.1",
    "serve": "^14.2.6",
    "start-server-and-test": "^3.0.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
